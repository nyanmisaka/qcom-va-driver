project('fastrpc', 'c', version: 'a56e9d4d', license: 'BSD-3-Clause',
  default_options: ['warning_level=0', 'werror=false', 'c_std=gnu11'])
cc = meson.get_compiler('c')
fastrpc_include_dir = meson.current_source_dir() / 'inc'
fastrpc_includes = include_directories('inc')
rpc = shared_library('iris_cdsprpc',
  'src/fastrpc_apps_user.c',
  'src/fastrpc_perf.c',
  'src/fastrpc_pm.c',
  'src/fastrpc_config.c',
  'src/fastrpc_mem.c',
  'src/fastrpc_notif.c',
  'src/fastrpc_ioctl.c',
  'src/fastrpc_log.c',
  'src/fastrpc_procbuf.c',
  'src/fastrpc_cap.c',
  'src/log_config.c',
  'src/dspsignal.c',
  'src/dspqueue/dspqueue_cpu.c',
  'src/dspqueue/dspqueue_rpc_stub.c',
  'src/listener_android.c',
  'src/apps_std_imp.c',
  'src/apps_mem_imp.c',
  'src/apps_mem_skel.c',
  'src/rpcmem_linux.c',
  'src/adspmsgd.c',
  'src/adspmsgd_printf.c',
  'src/std_path.c',
  'src/std_dtoa.c',
  'src/BufBound.c',
  'src/platform_libs.c',
  'src/pl_list.c',
  'src/gpls.c',
  'src/remotectl_stub.c',
  'src/remotectl1_stub.c',
  'src/adspmsgd_apps_skel.c',
  'src/adspmsgd_adsp_stub.c',
  'src/adspmsgd_adsp1_stub.c',
  'src/apps_remotectl_skel.c',
  'src/adsp_current_process_stub.c',
  'src/adsp_current_process1_stub.c',
  'src/adsp_listener_stub.c',
  'src/adsp_listener1_stub.c',
  'src/apps_std_skel.c',
  'src/adsp_perf_stub.c',
  'src/adsp_perf1_stub.c',
  'src/mod_table.c',
  'src/fastrpc_context.c',
  'src/fastrpc_config_parser.c',
  include_directories: fastrpc_includes,
  dependencies: [dependency('threads'), dependency('yaml-0.1'), dependency('libbsd-overlay'),
                 cc.find_library('dl'), cc.find_library('m')],
  c_args: ['-fno-short-enums', '-U_DEBUG', '-DARM_ARCH_7A', '-DLE_ENABLE',
           '-DENABLE_UPSTREAM_DRIVER_INTERFACE', '-DUSE_SYSLOG', '-DPARSE_YAML',
           '-DDEFAULT_DOMAIN_ID=3', '-DCONFIG_BASE_DIR="/usr/share/qcom/"',
           '-DMACHINE_NAME_PATH="/sys/firmware/devicetree/base/model"',
           '-DDEFAULT_DSP_SEARCH_PATHS=";/usr/lib/rfsa/adsp;/usr/lib/dsp;"'],
  override_options: ['werror=false'],
  install: true, install_dir: get_option('libdir') / 'qcom-va-driver')
fastrpc_dep = declare_dependency(link_with: rpc, include_directories: fastrpc_includes)
install_data('LICENSE.txt', install_dir: get_option('datadir') / 'licenses/qcom-va-driver/fastrpc')
