#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@ --buildsystem=meson

override_dh_auto_configure:
	dh_auto_configure -- -Dgpu_copy=enabled -Dcdsp_vpp=disabled -Dvulkan_vpp=enabled

override_dh_auto_install:
	dh_auto_install
	rm -rf debian/qcom-va-driver/usr/share/licenses
